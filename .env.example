# Only for `npm run dev:local`: where the Vite dev server proxies /v1, /ready and /health (your own Olga.Core).
# `npm run dev` and `npm run dev:prod` use the URLs in environments.json instead.
# App settings (environment, API URL, mocks, auth) live in public/config.json; override locally
# with a gitignored public/config.local.json.
CORE_API_PROXY_TARGET=http://localhost:5000
